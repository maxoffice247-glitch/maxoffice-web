# Copy this file to .env.local for local development and fill in real values.
# On Vercel, add these same variable names under Project Settings → Environment Variables.
# Never commit real values — only this file (with placeholders) is safe to commit.

# Zoho SMTP — sends the lead-notification email to cskh@maxoffice.vn for every form submission.
ZOHO_EMAIL=
ZOHO_APP_PASSWORD=
ZOHO_SMTP_HOST=
ZOHO_SMTP_PORT=

# Google Sheet webhook (Apps Script) — appends every form submission as a row.
GOOGLE_SHEET_WEBHOOK_URL=

# Google Places API — powers the static Google Reviews rating tile.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_PLACE_ID=
GOOGLE_PLACES_ADDRESS=

# Cổng thông tin khách hàng (portal) — tra cứu hợp đồng, Phase 1.

# Upstash Redis (REST) — OTP, phiên tra cứu, rate-limit IP, cache dữ liệu
# hợp đồng đã gộp từ 3 sheet nguồn. Liên kết qua Vercel Marketplace (mục
# Storage > Upstash) — Vercel TỰ ĐỘNG bơm các biến KV_* này vào môi trường
# production/preview, chỉ cần khai báo tay ở đây cho local dev (copy đúng
# giá trị Vercel hiện trong Project Settings → Environment Variables).
# Cố ý dùng tên KV_REST_API_URL/TOKEN (không phải UPSTASH_REDIS_REST_URL/
# TOKEN như tên gốc bên Upstash) để KHỎI phải tự tay thêm biến trùng lặp
# mỗi lần deploy — cùng 1 Upstash Redis database phía sau, chỉ khác tên.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Google Sheets API key (KHÔNG cần OAuth/service account — 3 sheet nguồn
# đều ở chế độ "Bất kỳ ai có link đều xem được"). Tạo tại Google Cloud
# Console > APIs & Services > Credentials > Create API key, sau khi đã bật
# "Google Sheets API" cho project.
GOOGLE_SHEETS_API_KEY=

# Mật khẩu tra cứu DÙNG CHUNG cho nhóm "moc-gia" (sheet DU_LIEU không có
# cột SĐT/email nên không xác minh được qua OTP) — Mức 2 so khớp trực tiếp
# giá trị này khi record không có SĐT/email. Để trống dùng mặc định
# "Camonquykhach" (xem search/route.ts) — đặt giá trị khác ở đây khi cần
# đổi mật khẩu thật, không cần sửa code hay thêm cột vào Sheets.
PORTAL_MOC_GIA_SHARED_PASSWORD=

# Bí mật để Vercel Cron gọi /api/cron/portal-sync — Vercel tự gửi kèm
# header "Authorization: Bearer {CRON_SECRET}" cho cron job cấu hình trong
# vercel.json, chặn người ngoài gọi tuỳ ý làm hao quota Sheets API.
CRON_SECRET=

# SePay — thanh toán đăng ký mới (Phase 2, CHƯA dùng ở Phase 1). Để trống
# cho tới khi có VA riêng của portal — không chặn việc chạy Phase 1.
SEPAY_PORTAL_BANK_BIN=970432
SEPAY_PORTAL_VA=
SEPAY_PORTAL_ACCOUNT_NAME=
# Xác thực webhook — CÁCH 1: query string ?key=... gắn vào URL đăng ký
# trên dashboard SePay (đơn giản, dùng ngay được).
SEPAY_PORTAL_API_KEY=
# Xác thực webhook — CÁCH 2 (khuyến nghị mạnh hơn, TUỲ CHỌN, dùng SONG
# SONG với cách 1 — route chấp nhận cả 2, chỉ cần 1 cách đúng): Secret Key
# lấy từ dashboard SePay khi bật chế độ "HMAC-SHA256" cho webhook — CHỈ
# hiện 1 LẦN lúc tạo, phải lưu ngay, SePay không lưu lại bản gốc. Để trống
# nếu chưa bật HMAC trên dashboard (webhook vẫn hoạt động bình thường qua
# ?key= ở trên).
SEPAY_PORTAL_WEBHOOK_SECRET=

# Mật khẩu công cụ nội bộ "Đề nghị thanh toán" (/tien-ich/de-nghi-thanh-toan-mat-bang)
# — chặn xem thông tin khách thuê thật (MST/SĐT/số hợp đồng). Để trống dùng
# mặc định "MaxOffice@2026" (xem paymentRequestAuth.ts) — đổi giá trị ở đây
# khi cần đổi mật khẩu thật, không cần sửa code.
PAYMENT_REQUEST_TOOL_PASSWORD=
