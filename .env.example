# Copy this file to .env.local for local development and fill in real values.
# On Vercel, add these same variable names under Project Settings → Environment Variables.
# Never commit real values — only this file (with placeholders) is safe to commit.

# Zoho SMTP — sends the lead-notification email to cskh@maxoffice.vn for every form submission.
ZOHO_EMAIL=
ZOHO_APP_PASSWORD=
ZOHO_SMTP_HOST=
ZOHO_SMTP_PORT=

# Google Sheet webhook (Apps Script) — appends every form submission as a row.
GOOGLE_SHEET_WEBHOOK_URL=

# Google Places API — powers the static Google Reviews rating tile.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_PLACE_ID=
GOOGLE_PLACES_ADDRESS=

# Cổng thông tin khách hàng (portal) — tra cứu hợp đồng, Phase 1.

# Upstash Redis (REST) — OTP, phiên tra cứu, rate-limit IP, cache dữ liệu
# hợp đồng đã gộp từ 3 sheet nguồn. Tạo miễn phí tại upstash.com hoặc qua
# Vercel Marketplace (tự điền 2 biến này khi liên kết).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Google Sheets API key (KHÔNG cần OAuth/service account — 3 sheet nguồn
# đều ở chế độ "Bất kỳ ai có link đều xem được"). Tạo tại Google Cloud
# Console > APIs & Services > Credentials > Create API key, sau khi đã bật
# "Google Sheets API" cho project.
GOOGLE_SHEETS_API_KEY=

# Bí mật để Vercel Cron gọi /api/cron/portal-sync — Vercel tự gửi kèm
# header "Authorization: Bearer {CRON_SECRET}" cho cron job cấu hình trong
# vercel.json, chặn người ngoài gọi tuỳ ý làm hao quota Sheets API.
CRON_SECRET=

# SePay — thanh toán đăng ký mới (Phase 2, CHƯA dùng ở Phase 1). Để trống
# cho tới khi có VA riêng của portal — không chặn việc chạy Phase 1.
SEPAY_PORTAL_BANK_BIN=970432
SEPAY_PORTAL_VA=
SEPAY_PORTAL_ACCOUNT_NAME=
SEPAY_PORTAL_API_KEY=
